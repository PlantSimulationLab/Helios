#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_shader_atomic_float : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

// Diffuse ray generation shader
// Launches rays from surfaces in hemispherical directions for diffuse radiation transfer

// Workgroup size: 8×32×1 = 256 threads
layout(local_size_x = 8, local_size_y = 32, local_size_z = 1) in;

// Push constants (launch parameters)
layout(push_constant) uniform PushConstants {
    uint launch_offset;
    uint launch_count;
    uint rays_per_primitive;
    uint random_seed;
    uint band_count;
    uint source_count;
    uint primitive_count;
    uint launch_face;      // 0 = bottom face, 1 = top face
    uint launch_dim_x;     // Grid dimension X for stratified hemisphere sampling
    uint launch_dim_y;     // Grid dimension Y for stratified hemisphere sampling
    uint material_band_count;  // Global band count (for material buffers)
    uint periodic_flag_x;      // 1 if periodic in X direction
    uint periodic_flag_y;      // 1 if periodic in Y direction
    uint bbox_count;           // Number of bbox faces (0-4)
    float domain_xmin;         // Domain bounds for periodic wrapping
    float domain_xmax;
    float domain_ymin;
    float domain_ymax;
    uint prim_tiles_y;     // Number of primitive tiles in Y dimension (for large primitive counts)
    uint prims_per_tile;   // Primitives per tile (65535 max)
    uint camera_count;     // Number of cameras; 0 = skip camera-weighted scatter
    uint camera_id;        // Camera whose weighting the camera-scatter buffers accumulate
    uint face_absorption_enabled; // 1 = also accumulate the absorption that arrived on the top face into radiation_in_top
    uint below_horizon_diffuse_enabled; // 1 = the diffuse sky also reaches rays leaving below the horizon
    uint specular_reflection_enabled; // 1 = this launch evaluates the surface layers' reflection lobe of the direct radiation
    uint forward_scatter_enabled; // 1 = accumulate the forward scattering estimate into forward_scatter (scattering launches)
} pc;

// ========== Descriptor Set 0: Geometry ==========
layout(set = 0, binding = 0) readonly buffer BVHBuffer {
    float data[]; // BVHNode array (accessed via bvh_traversal.glsl)
} bvh_buf;

layout(set = 0, binding = 2) readonly buffer TransformMatricesBuffer {
    float matrices[]; // 16 floats per primitive (row-major)
} transform_buf;

layout(set = 0, binding = 3) readonly buffer PrimTypesBuffer {
    uint types[];
} prim_types_buf;

layout(set = 0, binding = 4) readonly buffer PrimUUIDsBuffer {
    uint uuids[];
} prim_uuids_buf;

layout(set = 0, binding = 5) readonly buffer PrimPositionsBuffer {
    uint positions[];
} prim_positions_buf;

layout(set = 0, binding = 6) readonly buffer ObjectSubdivisionsBuffer {
    ivec2 subdivisions[];
} obj_subdivisions_buf;

layout(set = 0, binding = 7) readonly buffer TwosidedFlagBuffer {
    uint twosided_flags[];
} twosided_buf;

layout(set = 0, binding = 8) readonly buffer LeafRecordBuffer {
    vec4 records[]; // 4 vec4 per BVH leaf slot (layout in common/intersections.glsl)
} leaf_records_buf;

layout(set = 0, binding = 10) readonly buffer NormalsBuffer {
    float normals[]; // 3 floats per primitive (pre-computed world-space normal)
} normals_buf;

// ---- Texture masking buffers ----
layout(set = 0, binding = 11) readonly buffer MaskDataBuffer { uint mask_data[]; } mask_data_buf;
layout(set = 0, binding = 12) readonly buffer MaskSizesBuffer { ivec2 mask_sizes[]; } mask_sizes_buf;
layout(set = 0, binding = 13) readonly buffer MaskOffsetsBuffer { uint mask_offsets[]; } mask_offsets_buf;
layout(set = 0, binding = 14) readonly buffer MaskIDsBuffer { int mask_ids[]; } mask_ids_buf;
layout(set = 0, binding = 15) readonly buffer UVDataBuffer { vec2 uv_data[]; } uv_data_buf;
layout(set = 0, binding = 16) readonly buffer UVIDsBuffer { int uv_ids[]; } uv_ids_buf;

// ---- Periodic boundary bbox vertices ----
layout(set = 0, binding = 17) readonly buffer BboxVerticesBuffer {
    float vertices[]; // 12 floats per face (4 vec3 vertices)
} bbox_verts_buf;
// Periodic copies of the domain rays track (see common/periodic_boundary.glsl and VulkanComputeBackend::uploadPeriodicInfo())
layout(set = 0, binding = 22) readonly buffer PeriodicInfoBuffer {
    uint tile_tracking; // 1 if rays track the periodic copy of the domain they are in
    int max_repeats_x; // periodic copies on each side of the central domain; -1 for no limit
    int max_repeats_y;
    float repeated_zmin; // z-range of the geometry that repeats
    float repeated_zmax;
    float escape_offset; // distance beyond a face from which a ray leaving the periodic copies continues
    int camera_tile_x; // periodic copy of the domain the camera is in (camera and pixel-label launches)
    int camera_tile_y;
    uint flux_field_count; // radiation fields: 2 with a background field (see common/buffer_indexing.glsl), else 1
    uint flux_slot_count; // flux slots of the outgoing, scattered, camera and direct-flux buffers: primitive_count per field
    uint normal_map_slot_count; // normal-map slots; the background field's moments are in slots normal_map_slot_count + slot
    uint vertex_field_stride; // smoothing vertices; the background field's vertex values are at vertex_field_stride + vertex
} periodic_info_buf;
// Whether each primitive is excluded from the periodic boundary (1) or not (0); a one-element placeholder unless there is a background radiation field (see common/buffer_indexing.glsl)
layout(set = 0, binding = 23) readonly buffer PeriodicExcludedBuffer {
    uint excluded[];
} periodic_excluded_buf;

// ========== Descriptor Set 1: Materials/Sources ==========
// NOTE on the three-float source/sky arrays below: std430 gives an array of `vec3` a 16-byte
// stride, while the host uploads tightly-packed 12-byte helios::vec3. Declaring them as `vec3[]`
// therefore reads the wrong 12 bytes for every element after the first, and reads past the end of
// the allocation for the last one. They are declared as flat float arrays and fetched three at a
// time instead, matching normals_buf.
layout(set = 1, binding = 0) readonly buffer SourcePositionsBuffer {
    float positions[]; // 3 floats per source
} source_positions_buf;

layout(set = 1, binding = 1) readonly buffer SourceTypesBuffer {
    uint types[];
} source_types_buf;

layout(set = 1, binding = 2) readonly buffer SourceRotationsBuffer {
    float rotations[]; // 3 floats per source
} source_rotations_buf;

layout(set = 1, binding = 3) readonly buffer SourceWidthsBuffer {
    vec2 widths[];
} source_widths_buf;

layout(set = 1, binding = 4) readonly buffer SourceFluxesBuffer {
    float fluxes[];
} source_fluxes_buf;

layout(set = 1, binding = 5) readonly buffer ReflectivityBuffer {
    float reflectivity[]; // [primitive * band_count + band]
} reflectivity_buf;

layout(set = 1, binding = 6) readonly buffer TransmissivityBuffer {
    float transmissivity[];
} transmissivity_buf;

// Camera-weighted material properties, indexed [slot][primitive][band_global][camera]. The diffuse
// and scattering passes carry no source of their own, so they read the diffuse/scatter slot at index
// source_count, weighted by the band's combined incident spectrum, exactly as OptiX does (its
// diffuse/scatter ray generation sets source_ID = Nsources).
layout(set = 1, binding = 14) readonly buffer ReflectivityCamBuffer {
    float reflectivity_cam[];
} reflectivity_cam_buf;

layout(set = 1, binding = 15) readonly buffer TransmissivityCamBuffer {
    float transmissivity_cam[];
} transmissivity_cam_buf;

// Camera-weighted reflectivity of a spectrally flat, perfectly white surface, indexed [source][band_global][camera]. Weighting the
// light arriving at a primitive by it gives what each camera would record from a white surface there: its white reference.
layout(set = 1, binding = 16) readonly buffer WhiteReferenceCamBuffer {
    float white_reference_cam[];
} white_reference_cam_buf;

layout(set = 1, binding = 10) readonly buffer BandMapBuffer {
    uint map[]; // Maps launch band index → global band index
} band_map_buf;

// Translucent cover (glass/plastic) material. Same [prim * material_band_count + global_band] indexing
// as reflectivity/transmissivity (source-0 slice; glass is source-independent).
layout(set = 1, binding = 11) readonly buffer IsGlassBuffer {
    uint is_glass[];
} is_glass_buf;

layout(set = 1, binding = 12) readonly buffer GlassNBuffer {
    float glass_n[];
} glass_n_buf;

layout(set = 1, binding = 13) readonly buffer GlassKLBuffer {
    float glass_KL[];
} glass_KL_buf;

// ========== Descriptor Set 2: Results ==========
layout(set = 2, binding = 0) buffer RadiationInBuffer {
    float radiation_in[]; // [primitive * band_count + band]
} rad_in_buf;

// Absorption that arrived on the top face (the side the normal points to), same layout as radiation_in. Written only when
// pc.face_absorption_enabled is set; otherwise it is a one-element placeholder.
// Forward scattering estimate [primitive * band_count + band] (see RadiationModel::runBand()); written only when pc.forward_scatter_enabled
layout(set = 2, binding = 20) buffer ForwardScatterBuffer {
    float forward_scatter[];
} forward_scatter_buf;

layout(set = 2, binding = 15) buffer RadiationInTopBuffer {
    float radiation_in_top[]; // [primitive * band_count + band]
} rad_in_top_buf;

layout(set = 2, binding = 1) readonly buffer RadiationOutTopBuffer {
    float radiation_out_top[]; // Energy emitted from top face
} rad_out_top_buf;

layout(set = 2, binding = 2) readonly buffer RadiationOutBottomBuffer {
    float radiation_out_bottom[]; // Energy emitted from bottom face
} rad_out_bottom_buf;

layout(set = 2, binding = 3) buffer ScatterTopBuffer {
    float scatter_top[]; // Scattered energy from top face
} scatter_top_buf;

layout(set = 2, binding = 4) buffer ScatterBottomBuffer {
    float scatter_bottom[]; // Scattered energy from bottom face
} scatter_bottom_buf;

// ========== Descriptor Set 3: Sky Parameters ==========
// Camera-weighted scatter, accumulated against rho_cam/tau_cam alongside the band-weighted scatter, with one
// [primitive][band] block per camera (camera-major) so every camera gets its own spectral weighting.
layout(set = 2, binding = 8) buffer CameraScatterTopBuffer {
    float camera_scatter_top[];
} camera_scatter_top_buf;

layout(set = 2, binding = 9) buffer CameraScatterBottomBuffer {
    float camera_scatter_bottom[];
} camera_scatter_bottom_buf;

// Each camera's white reference, laid out like the camera-weighted scatter. Zeroed once per runBand(), so it accumulates over all its launches.
layout(set = 2, binding = 13) buffer WhiteReferenceTopBuffer {
    float white_reference_top[];
} white_reference_top_buf;

layout(set = 2, binding = 14) buffer WhiteReferenceBottomBuffer {
    float white_reference_bottom[];
} white_reference_bottom_buf;

// ========== Descriptor Set 4: Ray counters ==========
// counters[0]: rays abandoned at the periodic wrap limit, read back by the host after the launches of a runBand() call
layout(set = 4, binding = 0) buffer RayCountersBuffer {
    uint counters[];
} ray_counters_buf;

layout(set = 3, binding = 0) readonly buffer DiffuseFluxBuffer {
    float diffuse_flux[]; // [band] - Sky irradiance per band
} diffuse_flux_buf;

layout(set = 3, binding = 1) readonly buffer DiffusePeakDirBuffer {
    float diffuse_peak_dir[]; // [band] - Sun direction per band, 3 floats per band
} diffuse_peak_dir_buf;

vec3 get_diffuse_peak_dir(uint band) {
    uint b = band * 3u;
    return vec3(diffuse_peak_dir_buf.diffuse_peak_dir[b], diffuse_peak_dir_buf.diffuse_peak_dir[b + 1u], diffuse_peak_dir_buf.diffuse_peak_dir[b + 2u]);
}

layout(set = 3, binding = 2) readonly buffer DiffuseExtinctionBuffer {
    float diffuse_extinction[]; // [band] - Power-law K parameter
} diffuse_extinction_buf;

layout(set = 3, binding = 3) readonly buffer DiffuseDistNormBuffer {
    float diffuse_dist_norm[]; // [band] - Power-law normalization
} diffuse_dist_norm_buf;

layout(set = 3, binding = 4) readonly buffer SkyRadianceParamsBuffer {
    vec4 sky_radiance_params[]; // [band] - Prague model params (circ_str, circ_width, horiz_bright, norm)
} sky_radiance_params_buf;

// ========== Include common shader utilities ==========
#include "common/random.glsl"
#include "common/transforms.glsl"
#include "common/buffer_indexing.glsl"
#include "common/glass_cover.glsl"
#include "common/bvh_traversal.glsl"
#include "common/periodic_boundary.glsl"
#include "common/sky_distribution.glsl"
#include "common/texture_mask.glsl"
#include "common/surface_layer.glsl"
#include "common/spectral_texture.glsl"
#include "common/normal_map.glsl"

// Direct flux reaching primitives with a surface layer [source][flux slot][band], for their reflection lobe of it
layout(set = 2, binding = 10) readonly buffer RadiationSpecularBuffer {
    float radiation_specular[];
} radiation_specular_buf;

// A surface a diffuse ray reaches, as the ray sees it
struct SurfaceHit {
    uint prim; // primitive index
    vec3 point; // where the ray reaches it
    vec3 normal; // the primitive's normal
    bool top_face; // whether the ray reaches the top face
    bool shaded; // whether the primitive has a surface layer and a normal map, whose shading normal its angle-dependent terms use
    vec3 shading_top; // shading normal on the top face (only if shaded)
    float cos_angle; // cosine of the angle between the ray and the shading normal (the normal if not shaded)
};

// Describes the surface of primitive hit_prim where a ray along ray_direction reaches it at hit_point; hit_uv is where on the facet that is, as traverse_cwbvh() reports it
SurfaceHit describe_surface_hit(uint hit_prim, vec2 hit_uv, vec3 hit_point, vec3 ray_direction) {
    SurfaceHit hit;
    hit.prim = hit_prim;
    hit.point = hit_point;
    uint hit_nbase = hit_prim * 3;
    hit.normal = vec3(normals_buf.normals[hit_nbase], normals_buf.normals[hit_nbase + 1], normals_buf.normals[hit_nbase + 2]);
    hit.top_face = dot(hit.normal, ray_direction) < 0.0;
    // The angle-dependent terms of a hit primitive's surface layer see the ray at the angle of its shading normal; a Lambertian surface sends out the same radiance at every
    // angle, so only a layered primitive with a normal map needs the shading normal here
    uint hit_map = nm_map_index(hit_prim);
    hit.shaded = hit_map != NO_NORMAL_MAP && surface_layer_present(hit_prim);
    hit.shading_top = vec3(0.0, 0.0, 1.0);
    if (hit.shaded) {
        uint hit_type = prim_types_buf.types[hit_prim];
        vec2 hit_sp = hit_type == 1u ? vec2(hit_uv.y, hit_uv.x + hit_uv.y) : vec2(hit_uv.x - 0.5, hit_uv.y - 0.5);
        hit.shading_top = nm_shading_normal(hit_prim, hit_type, hit_map, normalize(hit.normal), hit_sp.x, hit_sp.y, false);
    }
    hit.cos_angle = hit.shaded ? abs(dot(hit.shading_top, ray_direction)) : abs(dot(normalize(hit.normal), ray_direction));
    return hit;
}

// Flux, in the units of the outgoing buffers, that a surface sends toward a ray that reaches it along ray_direction, in launch band `band` (global band global_b), read from radiation field `field`
// (see common/buffer_indexing.glsl). Must match the reading of the hit surface in gatherFromSurface() in OptiX8DeviceCode.cu.
float surface_outgoing_flux(SurfaceHit hit, vec3 ray_direction, uint band, uint global_b, uint field) {
    uint hit_rad_idx = index_prim_band(flux_slot(hit.prim, field), band, pc.band_count);

    float outgoing;
    if (hit.top_face) {
        outgoing = rad_out_top_buf.radiation_out_top[hit_rad_idx];
    } else {
        outgoing = rad_out_bottom_buf.radiation_out_bottom[hit_rad_idx];
    }
    // A hit primitive with a surface layer sends out its two components, in proportions that depend on the angle
    int hit_layer = surface_layer_table(hit.prim, global_b);
    if (hit_layer >= 0) {
        uint layer_offset = flux_slot_stride();
        float second = hit.top_face ? rad_out_top_buf.radiation_out_top[layer_offset + hit_rad_idx] : rad_out_bottom_buf.radiation_out_bottom[layer_offset + hit_rad_idx];
        outgoing = surface_layer_outgoing(outgoing, second, hit_layer, hit.cos_angle);
        // In the launch that reads the first scattering of the direct radiation, add the layer's reflection lobe of it
        if (pc.specular_reflection_enabled != 0u) {
            vec3 to_viewer = -ray_direction;
            vec3 face_normal = normalize(hit.normal);
            if (dot(face_normal, to_viewer) < 0.0) {
                face_normal = -face_normal;
            }
            // With a normal map, the lobe is around the shading normal on the viewed side, and the incident flux is carried from the facet's cosine to the shading normal's
            vec3 viewed_shading = dot(normalize(hit.normal), face_normal) > 0.0 ? hit.shading_top : -hit.shading_top;
            float reflected = 0.0;
            for (uint s = 0u; s < pc.source_count; s++) {
                float incident = radiation_specular_buf.radiation_specular[direct_flux_index(s, hit.prim, field, band)];
                if (incident <= 0.0) {
                    continue;
                }
                vec3 source_position = vec3(source_positions_buf.positions[s * 3u], source_positions_buf.positions[s * 3u + 1u], source_positions_buf.positions[s * 3u + 2u]);
                uint source_type = source_types_buf.types[s];
                // A collimated source or the sun sphere lies in one direction; a finite source is seen in the direction of its centre
                vec3 to_source = (source_type == 0u || source_type == 2u) ? normalize(source_position) : normalize(source_position - hit.point);
                if (hit.shaded) {
                    float mu_facet = dot(face_normal, to_source);
                    float mu_shading = dot(viewed_shading, to_source);
                    if (mu_facet <= 0.0 || mu_shading <= 0.0) {
                        continue; // the radiation reached the other face, or the shading normal faces away from the source
                    }
                    reflected += incident * mu_shading / mu_facet * nm_terminator_softening(face_normal, viewed_shading, to_source) * surface_layer_lobe(hit_layer, viewed_shading, to_source, to_viewer);
                } else {
                    reflected += incident * surface_layer_lobe(hit_layer, face_normal, to_source, to_viewer);
                }
            }
            outgoing += 3.14159265359 * reflected;
        }
    }
    return outgoing;
}

// ========== Helper Functions ==========

// Sample random point on patch (matches CUDA)
vec3 sample_patch(inout RNGState rng, ivec2 subdivision, ivec2 sub_cell) {
    int NX = subdivision.x;
    int NY = subdivision.y;

    float dx = 1.0 / float(NX);
    float dy = 1.0 / float(NY);

    float Rx = rng_float(rng);
    float Ry = rng_float(rng);

    // Map to patch local space [-0.5, 0.5] x [-0.5, 0.5]
    vec3 sp;
    sp.x = -0.5 + (sub_cell.x + Rx) * dx;
    sp.y = -0.5 + (sub_cell.y + Ry) * dy;
    sp.z = 0.0;

    return sp;
}

// Sample random point on triangle
vec3 sample_triangle(inout RNGState rng) {
    float Rx = rng_float(rng);
    float Ry = rng_float(rng);

    vec3 sp;
    // Map to triangle with vertices (0,0,0), (0,1,0), (1,1,0)
    if (Rx < Ry) {
        sp.x = Rx;
        sp.y = Ry;
    } else {
        sp.x = Ry;
        sp.y = Rx;
    }
    sp.z = 0.0;

    return sp;
}

// Sample random point on disk (uniform distribution)
vec3 sample_disk(inout RNGState rng) {
    float Rx = rng_float(rng);
    float Ry = rng_float(rng);

    // Map to square [-1,1] x [-1,1]
    vec3 sp;
    sp.x = -1.0 + 2.0 * Rx;
    sp.y = -1.0 + 2.0 * Ry;

    // Concentric disk mapping (Shirley & Chiu 1997)
    float r, phi;
    if (sp.x > -sp.y) {
        if (sp.x > sp.y) {
            r = sp.x;
            phi = sp.y / sp.x;
        } else {
            r = sp.y;
            phi = 2.0 - sp.x / sp.y;
        }
    } else {
        if (sp.x < sp.y) {
            r = -sp.x;
            phi = 4.0 + sp.y / sp.x;
        } else {
            r = -sp.y;
            if (sp.y != 0.0) {
                phi = 6.0 - sp.x / sp.y;
            } else {
                phi = 0.0;
            }
        }
    }
    phi *= 0.25 * 3.14159265359;

    sp.x = r * cos(phi);
    sp.y = r * sin(phi);
    sp.z = 0.0;

    return sp;
}

// Rotate local hemisphere direction to align with surface normal
// Local frame: Z-up (hemisphere aligned with +Z axis)
// World frame: Arbitrary normal direction
vec3 rotate_to_normal(vec3 dir_local, vec3 normal) {
    // Compute rotation to align Z-axis with normal
    // Using spherical coordinate rotation (matches CUDA d_rotatePoint)

    // Elevation angle (from Z-axis)
    float elevation = acos(clamp(normal.z, -1.0, 1.0));

    // Azimuthal angle (in XY plane). atan(y, x) is explicitly undefined in GLSL when both
    // arguments are zero, which is the case for every perfectly horizontal primitive
    // (normal == (0,0,+/-1)) and for the (0,0,1) fallback the host substitutes for any
    // primitive whose vertices are degenerate. The azimuth is arbitrary in that case, so pick
    // zero rather than leave it to the implementation.
    float azimuth = (abs(normal.x) > 0.0 || abs(normal.y) > 0.0) ? atan(normal.y, normal.x) : 0.0;

    // Rotate local direction to world frame
    // First rotate around Y by elevation, then around Z by azimuth
    float ce = cos(elevation);
    float se = sin(elevation);
    float ca = cos(azimuth);
    float sa = sin(azimuth);

    // Rotation matrix: Rz(azimuth) × Ry(elevation)
    vec3 dir_world;
    dir_world.x = dir_local.x * (ce * ca) - dir_local.y * sa + dir_local.z * (se * ca);
    dir_world.y = dir_local.x * (ce * sa) + dir_local.y * ca + dir_local.z * (se * sa);
    dir_world.z = -dir_local.x * se + dir_local.z * ce;

    return normalize(dir_world);
}

// ========== Main Shader ==========
void main() {
    // 3D dispatch with 2D primitive tiling: X = ray grid X, Y = ray grid Y + primitive tiles, Z = primitives
    // For large primitive counts (>65535), primitives are tiled into the Y dimension to avoid exceeding
    // the Vulkan maxComputeWorkGroupCount[2] limit of 65535.
    uint launch_x = gl_GlobalInvocationID.x;  // Ray grid X [0, launch_dim_x)

    // Decode Y dimension: lower bits = ray grid Y, upper bits = primitive tile index
    const uint WG_Y = 32;  // Must match layout(local_size_y = 32)
    uint threads_per_tile = ((pc.launch_dim_y + WG_Y - 1) / WG_Y) * WG_Y;  // Round up to workgroup multiple
    uint prim_tile_y = gl_GlobalInvocationID.y / threads_per_tile;
    uint launch_y = gl_GlobalInvocationID.y % threads_per_tile;  // Position within tile [0, threads_per_tile)

    // Decode primitive index from 2D tiling
    uint prim_batch_idx = prim_tile_y * pc.prims_per_tile + gl_GlobalInvocationID.z;

    // Bounds check: ray grid
    if (launch_x >= pc.launch_dim_x || launch_y >= pc.launch_dim_y) {
        return;
    }

    // Bounds check: primitive index
    if (prim_batch_idx >= pc.launch_count) {
        return;
    }

    uint prim_idx = pc.launch_offset + prim_batch_idx;

    if (prim_idx >= pc.primitive_count) {
        return;
    }

    // Get primitive data
    uint prim_type = prim_types_buf.types[prim_idx];
    uint prim_uuid = prim_uuids_buf.uuids[prim_idx];
    ivec2 subdivisions = obj_subdivisions_buf.subdivisions[prim_idx];
    uint twosided = twosided_buf.twosided_flags[prim_idx];

    // A translucent cover books what reaches it with its angular glass properties, not rho/tau.
    bool origin_is_cover = glass_cover_all_bands(prim_idx, pc.band_count, pc.material_band_count);

    // The top face launches unless the primitive is invisible (twosided_flag = 3); the bottom face launches only for two-sided
    // primitives (twosided_flag = 1)
    if ((pc.launch_face == 1 && twosided == 3) || (pc.launch_face == 0 && twosided != 1)) {
        return;
    }

    // With a background radiation field, the rays of a primitive that is not excluded from the periodic boundary are dual rays (see traversal_record_excluded in common/bvh_traversal.glsl), which book
    // what they gather in both fields: field 1, the background, along the ray's path past the excluded primitives, and field 0, the scene as it is, where the ray ends in that scene. The primitive
    // is the same for every invocation of a workgroup, and so is the field count. Must match originBooksBothFields() in OptiX8DeviceCode.cu.
    bool background_field = dual_field();
    bool dual_ray = background_field && periodic_excluded_buf.excluded[prim_idx] == 0u;
    uint field_count = dual_ray ? 2u : 1u;
    traversal_record_excluded = dual_ray;
    uint field_stride = pc.primitive_count * pc.band_count; // one field's [primitive][band] block
    uint slot_stride = flux_slot_stride(); // one [flux slot][band] block of the outgoing, scattered and camera buffers

    // Total rays per primitive (matches CUDA: dimx = launch_dim.x * launch_dim.y)
    uint dimx = pc.launch_dim_x * pc.launch_dim_y;

    // Per-ray RNG seed (matches CUDA: tea(indx + dimx * launch_index.z, random_seed))
    uint ray_index = pc.launch_dim_x * launch_y + launch_x;
    RNGState rng = rng_init(pc.random_seed, ray_index + dimx * prim_idx);

    // Get transform matrix (16 floats per primitive)
    float transform_mat[16];
    for (uint i = 0; i < 16; ++i) {
        transform_mat[i] = transform_buf.matrices[prim_idx * 16 + i];
    }
    mat4 transform = floats_to_mat4(transform_mat);

    // Read pre-computed world-space normal from buffer
    uint nbase = prim_idx * 3;
    vec3 normal = vec3(normals_buf.normals[nbase], normals_buf.normals[nbase + 1], normals_buf.normals[nbase + 2]);

    // Ray strength (equal energy per ray)
    float strength = 1.0 / float(dimx);

    // Loop over sub-patches (matches OptiX: still loops over NX*NY sub-patches per thread)
    int NX = subdivisions.x;
    int NY = subdivisions.y;

    for (int jj = 0; jj < NY; ++jj) {
        for (int ii = 0; ii < NX; ++ii) {
            uint UUID = prim_uuid + jj * NX + ii;

            // Sample random point on primitive surface (per-ray, matching CUDA)
            vec3 sp_local;
            if (prim_type == 0 || prim_type == 3) { // Patch or Tile
                sp_local = sample_patch(rng, subdivisions, ivec2(ii, jj));
            } else if (prim_type == 1) { // Triangle
                sp_local = sample_triangle(rng);
            } else if (prim_type == 2) { // Disk
                sp_local = sample_disk(rng);
            } else {
                // Voxel (4) or bbox (5): no surface sampler exists, so sp_local would be read
                // uninitialized below. direct_raygen.comp already skips these; match it.
                continue;
            }

            // Origin masking: reject transparent texels (matches OptiX d_sampleTexture_patch, RayTracing.cuh:504)
            if (prim_type == 0 || prim_type == 3) { // Patch or Tile
                int mask_id_check = mask_ids_buf.mask_ids[prim_idx];
                if (mask_id_check >= 0) {
                    vec2 sample_uv = vec2(sp_local.x + 0.5, sp_local.y + 0.5);
                    int resample_count = 0;
                    while (!check_texture_mask(prim_idx, sample_uv, prim_type) && resample_count < 10) {
                        resample_count++;
                        float dx = 1.0 / float(NX);
                        float dy = 1.0 / float(NY);
                        sp_local.x = -0.5 + (float(ii) + rng_float(rng)) * dx;
                        sp_local.y = -0.5 + (float(jj) + rng_float(rng)) * dy;
                        sp_local.z = 0.0;
                        sample_uv = vec2(sp_local.x + 0.5, sp_local.y + 0.5);
                    }
                    // Launch from the last sample even if it is still transparent, as the OptiX backends do: dropping the ray would
                    // lose its share of the primitive's energy, which is large for a sparsely masked primitive
                }
            } else if (prim_type == 1 && mask_ids_buf.mask_ids[prim_idx] >= 0) {
                // Triangle origin masking via rejection sampling
                int mask_id = mask_ids_buf.mask_ids[prim_idx];
                bool masked = true;
                for (int attempt = 0; attempt < 50 && masked; attempt++) {
                    // Generate random point on canonical triangle
                    float r1 = rng_float(rng);
                    float r2 = rng_float(rng);
                    if (r1 + r2 > 1.0) { r1 = 1.0 - r1; r2 = 1.0 - r2; }
                    sp_local = vec3(r2, r1 + r2, 0.0); // canonical: x=gamma, y=beta+gamma
                    float beta = r1;  // sp_local.y - sp_local.x
                    float gamma = r2; // sp_local.x
                    masked = !mask_texel_is_opaque(mask_id, triangle_texture_uv(prim_idx, vec2(beta, gamma)));
                }
                // If all attempts hit transparent texels, launch from the last sample rather than drop the ray and its energy
            }

            // The class of a spectral texture at the launch point, whose reflectivity and transmissivity the rays from it use
            uint origin_palette_entry = spectral_palette_entry(prim_idx, spectral_origin_texel_uv(prim_idx, prim_type, sp_local));

            // Transform to world space
            vec3 ray_origin = transform_point(transform, sp_local);

            // Stratified random samples [0,1] within grid cell
            float Rt = (float(launch_x) + rng_float(rng)) / float(pc.launch_dim_x);
            float Rp = (float(launch_y) + rng_float(rng)) / float(pc.launch_dim_y);

            // Cosine-weighted hemisphere sampling
            // Theta in [0, π/2], Phi in [0, 2π]
            // Rt is < 1 by construction, but clamp before asin(): a value even one ulp above 1
            // would make theta NaN and poison every ray direction launched from this primitive.
            float theta = asin(sqrt(clamp(Rt, 0.0, 1.0)));
            float phi = 2.0 * 3.14159265359 * Rp;

            // Cartesian direction in local hemisphere frame (+Z up)
            vec3 dir_local;
            dir_local.x = sin(theta) * cos(phi);
            dir_local.y = sin(theta) * sin(phi);
            dir_local.z = cos(theta);

            // Rotate to align with surface normal. A normal map leaves the cosine lobe on the facet normal, so that the primitive gathers what its footprint intercepts (as a relief
            // that is a heightfield does); a surface layer at the origin sees each ray at its angle to the shading normal at the launch point.
            vec3 ray_direction = rotate_to_normal(dir_local, normal);
            float origin_cos = abs(dot(ray_direction, normalize(normal)));
            uint origin_map = nm_map_index(prim_idx);
            if (origin_map != NO_NORMAL_MAP && surface_layer_present(prim_idx)) {
                origin_cos = abs(dot(ray_direction, nm_shading_normal(prim_idx, prim_type, origin_map, normalize(normal), sp_local.x, sp_local.y, false)));
            }

            // Flip direction if launching from bottom face
            if (pc.launch_face == 0 && twosided == 1) {
                ray_direction = -ray_direction;
            }

            // Per-band translucent-cover transmittance accumulated as the ray passes through glass
            // covers (e.g. a greenhouse roof) on its way to the sky. Starts at 1 (no attenuation).
            float cover_tau[GLASS_MAX_BANDS];
            // Per-band radiance leaving the covers the ray passes (their reflection and emission), each attenuated by
            // the covers in front of it. It reaches this primitive like the radiance of the surface the ray ends on.
            float cover_radiance[GLASS_MAX_BANDS];
            // Per-band share of this ray's flux that the covers it passes reflect, for the forward scattering estimate
            float cover_rescattered[GLASS_MAX_BANDS];
            // A dual ray follows the background field's path, which the three arrays above describe. In the scene as it is (field 0) the ray ends on the first excluded primitive it
            // reaches, if any: field 0 is then settled, and keeps the transmittance and the reflected share of the covers crossed up to there. Its cover radiance is accumulated apart
            // from the start, since a cover in the central copy of the domain sends out a different radiance in each field. Must match resolveRecordedHit() in OptiX8DeviceCode.cu.
            float scene_cover_tau[GLASS_MAX_BANDS];
            float scene_cover_radiance[GLASS_MAX_BANDS];
            float scene_cover_rescattered[GLASS_MAX_BANDS];
            bool scene_settled = false;
            uint scene_end_prim = 0xFFFFFFFFu; // the excluded primitive field 0's ray ends on, once settled
            vec2 scene_end_uv = vec2(0.0);
            vec3 scene_end_point = vec3(0.0);
            for (uint cb = 0; cb < pc.band_count && cb < uint(GLASS_MAX_BANDS); ++cb) {
                cover_tau[cb] = 1.0;
                cover_radiance[cb] = 0.0;
                cover_rescattered[cb] = 0.0;
            }
            if (dual_ray) {
                for (uint cb = 0; cb < pc.band_count && cb < uint(GLASS_MAX_BANDS); ++cb) {
                    scene_cover_radiance[cb] = 0.0;
                }
            }

            // Trace ray through BVH with periodic-boundary wrap and translucent-cover pass-through.
            // A glass cover is not a terminating hit: accumulate its per-band transmittance, deposit its
            // reflected/absorbed energy, and re-trace past it (bounded iterations).
            float closest_t;
            uint hit_prim_idx;
            vec2 hit_uv = vec2(0.0);
            vec3 trace_origin = ray_origin;
            // A ray that reaches the periodic wrap limit or the segment limit ends without reaching the sky or a surface, and
            // deposits nothing, as in the OptiX backends.
            bool ray_terminated = false;
            int boundary_hits = 0;

            // No minimum distance: the primitive the ray was launched from is skipped (prim_idx), and a minimum distance let a
            // ray launched that close to an adjacent surface pass through it where the two meet
            float segment_t_min = 0.0;
            traversal_excluded_passed = false;
            start_periodic_ray(ivec2(0)); // launched from the central periodic copy of the domain
            for (int step = 0; step < MAX_RAY_SEGMENTS; ++step) {
                hit_prim_idx = traverse_cwbvh(
                    trace_origin,
                    ray_direction,
                    segment_t_min,
                    prim_idx, // origin primitive index (skip self-hits)
                    closest_t,
                    hit_uv // where on the facet the ray landed, for a normal map of the hit primitive
                );

                // Periodic boundary wrap (bbox face is not a real hit)
                if (pc.bbox_count != 0) {
                    vec3 wrapped_origin;
                    bool hit_periodic = check_periodic_boundary(
                        trace_origin, ray_direction, closest_t,
                        pc.periodic_flag_x, pc.periodic_flag_y, pc.bbox_count,
                        pc.domain_xmin, pc.domain_xmax, pc.domain_ymin, pc.domain_ymax,
                        wrapped_origin);
                    if (hit_periodic) {
                        if (++boundary_hits >= MAX_PERIODIC_WRAPS) { // wrap limit — the ray is abandoned
                            atomicAdd(ray_counters_buf.counters[0], 1u);
                            break;
                        }
                        trace_origin = wrapped_origin;
                        segment_t_min = 0.0; // a wrapped ray hits geometry right at the boundary it was wrapped to
                        continue;
                    }
                }

                if (hit_prim_idx == 0xFFFFFFFF) { // miss — reached the sky
                    ray_terminated = true;
                    break;
                }

                // In the scene as it is, a dual ray ends on the first excluded primitive it reaches: field 0 is settled there, before a cover's transmittance is applied, with the covers
                // crossed so far. The segment is then traced again without the excluded primitives (see traversal_excluded_passed), for the background field.
                if (dual_ray && !scene_settled && periodic_excluded_buf.excluded[hit_prim_idx] != 0u) {
                    scene_settled = true;
                    scene_end_prim = hit_prim_idx;
                    scene_end_uv = hit_uv;
                    scene_end_point = trace_origin + closest_t * ray_direction;
                    for (uint cb = 0; cb < pc.band_count && cb < uint(GLASS_MAX_BANDS); ++cb) {
                        scene_cover_tau[cb] = cover_tau[cb];
                        scene_cover_rescattered[cb] = cover_rescattered[cb];
                    }
                    traversal_excluded_passed = true;
                    set_periodic_tile(periodic_tile);
                    continue;
                }

                // A primitive that is not a translucent cover for all launched bands is a normal surface.
                if (!glass_cover_all_bands(hit_prim_idx, pc.band_count, pc.material_band_count)) { // real surface hit — handled by the band loop below (the origin primitive is hit only in another periodic copy, as any other primitive)
                    ray_terminated = true;
                    break;
                }

                // Glass pass-through: receive the cover's own outgoing radiance from the face the ray hits, then
                // accumulate its per-band transmittance. What the cover itself absorbs and reflects is booked by the
                // cover's own rays, not here: this ray was launched by the surface behind the cover, so its strength is
                // normalized to that surface's area and angle.
                uint cov_nbase = hit_prim_idx * 3;
                vec3 cov_normal = vec3(normals_buf.normals[cov_nbase], normals_buf.normals[cov_nbase + 1], normals_buf.normals[cov_nbase + 2]);
                float cov_cos = abs(dot(ray_direction, normalize(cov_normal)));
                bool cov_top = dot(cov_normal, ray_direction) < 0.0;
                // The field a ray reads the cover's radiance in is that of the copy of the domain the cover is in; a dual ray reads the background for field 1, and that field for field 0
                uint cov_seen_field = (background_field && periodic_tile != ivec2(0)) ? 1u : 0u;
                uint cov_field = dual_ray ? 1u : cov_seen_field;

                for (uint band = 0; band < pc.band_count && band < uint(GLASS_MAX_BANDS); ++band) {
                    uint cov_rad_idx = index_prim_band(flux_slot(hit_prim_idx, cov_field), band, pc.band_count);
                    float cover_out = cov_top ? rad_out_top_buf.radiation_out_top[cov_rad_idx] : rad_out_bottom_buf.radiation_out_bottom[cov_rad_idx];
                    cover_radiance[band] += cover_out * cover_tau[band];
                    if (dual_ray && !scene_settled) {
                        float scene_cover_out = cover_out;
                        if (cov_seen_field == 0u) {
                            uint scene_rad_idx = index_prim_band(hit_prim_idx, band, pc.band_count);
                            scene_cover_out = cov_top ? rad_out_top_buf.radiation_out_top[scene_rad_idx] : rad_out_bottom_buf.radiation_out_bottom[scene_rad_idx];
                        }
                        scene_cover_radiance[band] += scene_cover_out * cover_tau[band];
                    }
                    vec3 cover_tra = glass_cover_tau_rho_alpha(hit_prim_idx, band, pc.material_band_count, cov_cos);
                    cover_rescattered[band] += cover_tau[band] * cover_tra.y;
                    cover_tau[band] *= cover_tra.x;
                }

                trace_origin = trace_origin + ray_direction * (closest_t + 1e-4);
                segment_t_min = 1e-5;
            }

            // Process hit or miss — loop over all bands (BVH traversal is band-independent)
            bool hit_found = ray_terminated && (hit_prim_idx != 0xFFFFFFFF);
            bool miss_found = ray_terminated && (hit_prim_idx == 0xFFFFFFFF);
            // The diffuse sky fills only the upper hemisphere unless enabled below the horizon.
            bool sees_sky = ray_direction.z >= 0.0 || pc.below_horizon_diffuse_enabled != 0u;

            // Where the ray of each field booked ends, described once (shared across bands): the surface, if any, and the field its outgoing radiation is read in. The ray's own path is
            // that of the last field. It reads the surface it ends on in the field of the copy of the domain the surface is in (the scene as it is in the central copy, the background in
            // every other), but always in the background for field 1 of a dual ray. Field 0 of a dual ray ends on the excluded primitive it settled on, if any, and where the ray's own
            // path ends otherwise. Must match resolveRecordedHit() and closestHitDiffuse() in OptiX8DeviceCode.cu.
            uint path_field = field_count - 1u;
            uint hit_seen_field = (background_field && periodic_tile != ivec2(0)) ? 1u : 0u;
            SurfaceHit end_surface[2];
            bool end_on_surface[2] = bool[2](false, false);
            uint end_read_field[2] = uint[2](0u, 0u);
            if (hit_found) {
                end_surface[path_field] = describe_surface_hit(hit_prim_idx, hit_uv, trace_origin + closest_t * ray_direction, ray_direction);
                end_on_surface[path_field] = true;
                end_read_field[path_field] = dual_ray ? 1u : hit_seen_field;
            }
            if (dual_ray) {
                if (scene_settled) {
                    end_surface[0] = describe_surface_hit(scene_end_prim, scene_end_uv, scene_end_point, ray_direction);
                    end_on_surface[0] = true;
                    end_read_field[0] = 0u;
                } else if (hit_found) {
                    end_surface[0] = end_surface[1];
                    end_on_surface[0] = true;
                    end_read_field[0] = hit_seen_field;
                }
            }

            for (uint band = 0; band < pc.band_count; ++band) {
                uint global_b = band_map_buf.map[band];
                uint global_idx = index_prim_band(prim_idx, band, pc.band_count);
                uint mat_idx = (pc.source_count * pc.primitive_count + prim_idx) * pc.material_band_count + global_b; // diffuse/scatter slot
                bool use_palette = spectral_palette_applies(origin_palette_entry, global_b);
                float rho = use_palette ? spectral_palette_rho(pc.source_count, origin_palette_entry, global_b) : reflectivity_buf.reflectivity[mat_idx];
                float tau = use_palette ? spectral_palette_tau(pc.source_count, origin_palette_entry, global_b) : transmissivity_buf.transmissivity[mat_idx];
                float absorption_factor = 1.0 - rho - tau;

                // A translucent cover absorbs alpha(theta) and reflects rho(theta) back out of the launch face. The
                // transmitted tau(theta) continues through undeviated and is delivered to the surfaces behind the
                // cover by their own rays passing through it, so it is not scattered here.
                if (origin_is_cover) {
                    vec3 cover_tra = glass_cover_tau_rho_alpha(prim_idx, band, pc.material_band_count, abs(dot(ray_direction, normalize(normal))));
                    rho = cover_tra.y;
                    tau = 0.0;
                    absorption_factor = cover_tra.z;
                }

                // A surface layer reflects layer_albedo of what arrives; the body absorbs and scatters the rest
                float layer_albedo = 0.0;
                float body_fraction = 1.0;
                int layer = origin_is_cover ? -1 : surface_layer_table(prim_idx, global_b);
                if (layer >= 0) {
                    layer_albedo = surface_layer_albedo(layer, origin_cos);
                    body_fraction = 1.0 - layer_albedo;
                    absorption_factor *= body_fraction;
                    rho *= body_fraction;
                    tau *= body_fraction;
                }

                // The sky's energy a ray that leaves the scene brings: the sky's flux less that of the band's reference blackbody field, which follows the sky
                // fluxes in diffuse_flux: emission is gathered as its departure from that field (see RadiationModel::runBand()).
                float band_cover_tau = (band < uint(GLASS_MAX_BANDS)) ? cover_tau[band] : 1.0;
                float miss_energy = 0.0;
                // Sky energy only: the white reference counts light straight from the sky, not light
                // already coloured by another surface. It is that of the scene as it is, where an excluded primitive the ray settled on hides the sky.
                float white_reference_energy = 0.0;
                if (miss_found) {
                    float sky_flux = sees_sky ? diffuse_flux_buf.diffuse_flux[band] : 0.0;
                    float reference_flux = diffuse_flux_buf.diffuse_flux[pc.band_count + band];

                    if (sky_flux > 0.0 || reference_flux != 0.0) {
                        float fd = 0.0;
                        if (sky_flux > 0.0) {
                            vec3 peak_dir = get_diffuse_peak_dir(band);
                            float extinction = diffuse_extinction_buf.diffuse_extinction[band];
                            float dist_norm = diffuse_dist_norm_buf.diffuse_dist_norm[band];
                            vec4 sky_params = sky_radiance_params_buf.sky_radiance_params[band];
                            fd = evaluate_sky_distribution(ray_direction, peak_dir, extinction, dist_norm, sky_params);
                        }
                        // Attenuate sky radiation by any translucent covers the ray passed through.
                        float sky_energy = fd * sky_flux * strength * band_cover_tau;
                        miss_energy = sky_energy - reference_flux * strength * band_cover_tau;
                        white_reference_energy = scene_settled ? 0.0 : sky_energy;
                    }
                }

                // Forward scattering estimate (see RadiationModel::runBand()): the flux this ray carries away from this primitive along
                // its path, times the fraction of it the covers it passes and the surface it reaches scatter again. A hit surface's own
                // reflectivity is used, not that of a spectral-texture class at the hit point: the estimate need only be unbiased over
                // the scene, not per texel. It is that of the scene as it is (field 0), where that field's ray ends.
                float forward_val = 0.0;
                if (pc.forward_scatter_enabled != 0u) {
                    float launched = pc.launch_face == 1u ? rad_out_top_buf.radiation_out_top[global_idx] : rad_out_bottom_buf.radiation_out_bottom[global_idx];
                    int origin_layer = surface_layer_table(prim_idx, global_b);
                    if (origin_layer >= 0) {
                        float second = pc.launch_face == 1u ? rad_out_top_buf.radiation_out_top[slot_stride + global_idx] : rad_out_bottom_buf.radiation_out_bottom[slot_stride + global_idx];
                        launched = surface_layer_outgoing(launched, second, origin_layer, origin_cos);
                    }
                    float rescattered = 0.0;
                    float end_cover_tau = 1.0;
                    if (band < uint(GLASS_MAX_BANDS)) {
                        rescattered = scene_settled ? scene_cover_rescattered[band] : cover_rescattered[band];
                        end_cover_tau = scene_settled ? scene_cover_tau[band] : cover_tau[band];
                    }
                    if (end_on_surface[0]) {
                        uint end_prim = end_surface[0].prim;
                        float end_cos = end_surface[0].cos_angle;
                        uint hit_mat_idx = (pc.source_count * pc.primitive_count + end_prim) * pc.material_band_count + global_b; // diffuse/scatter slot
                        float hit_rescattered = reflectivity_buf.reflectivity[hit_mat_idx] + transmissivity_buf.transmissivity[hit_mat_idx];
                        int hit_layer_fwd = surface_layer_table(end_prim, global_b);
                        if (hit_layer_fwd >= 0) {
                            float hit_albedo = surface_layer_albedo(hit_layer_fwd, end_cos);
                            hit_rescattered = hit_albedo + (1.0 - hit_albedo) * hit_rescattered;
                        }
                        rescattered += end_cover_tau * hit_rescattered;
                    }
                    forward_val = abs(launched) * strength * rescattered;
                }
                // The push constant is the same for every invocation, so the reduction is reached uniformly
                if (pc.forward_scatter_enabled != 0u) {
                    float forward_sum = subgroupAdd(forward_val);
                    if (subgroupElect() && forward_sum != 0.0)
                        atomicAdd(forward_scatter_buf.forward_scatter[global_idx], forward_sum);
                }

                // Each field's arrival is booked in that field's flux slot of this primitive. The field count is the same for every invocation, so the subgroup reductions are reached
                // uniformly, and a scene without a background field makes those of one field. Must match gatherFromSurface() and bookSkyOnOrigin() in OptiX8DeviceCode.cu.
                for (uint field = 0u; field < field_count; field++) {
                    // Energy arriving at this primitive in this field: the radiation of the surface the field's ray ends on, or the sky's on a miss, attenuated by the translucent
                    // covers the ray passed on its way there, plus the radiance of those covers, received like that of a surface. Computed unconditionally (zero for an inactive path):
                    // subgroupAdd must be called by all active threads in the subgroup at the same point — calling it inside divergent if/else branches is undefined per spec.
                    // The surface is read at this one place for every field, so that the shader holds one copy of that code.
                    float field_energy = 0.0;
                    // Field 0 of a dual ray keeps the covers crossed up to the excluded primitive it settled on, and its own account of the covers' radiance
                    bool settled_field = field == 0u && scene_settled;
                    bool scene_field = field == 0u && dual_ray;
                    float field_cover_tau = band_cover_tau;
                    float field_cover_radiance = 0.0;
                    if (band < uint(GLASS_MAX_BANDS)) {
                        if (settled_field) {
                            field_cover_tau = scene_cover_tau[band];
                        }
                        field_cover_radiance = scene_field ? scene_cover_radiance[band] : cover_radiance[band];
                    }
                    if (end_on_surface[field]) {
                        field_energy = surface_outgoing_flux(end_surface[field], ray_direction, band, global_b, end_read_field[field]) * strength * field_cover_tau;
                    } else if (!settled_field) {
                        field_energy = miss_energy;
                    }
                    field_energy += field_cover_radiance * strength;

                    uint slot_idx = global_idx + field * field_stride; // [flux slot][band] index of the primitive in this field

                    // Subgroup reductions called uniformly by all threads (inactive paths contribute 0)
                    float scatter_top_sum = subgroupAdd(field_energy * (pc.launch_face == 1 ? rho : tau));
                    float scatter_bottom_sum = subgroupAdd(field_energy * (pc.launch_face == 1 ? tau : rho));
                    if (subgroupElect()) {
                        if (scatter_top_sum != 0.0)
                            atomicAdd(scatter_top_buf.scatter_top[slot_idx], scatter_top_sum);
                        if (scatter_bottom_sum != 0.0)
                            atomicAdd(scatter_bottom_buf.scatter_bottom[slot_idx], scatter_bottom_sum);
                    }
                    // What is absorbed is that of the scene as it is
                    if (field == 0u) {
                        float absorption_sum = subgroupAdd(field_energy * absorption_factor);
                        if (subgroupElect() && absorption_sum != 0.0) {
                            atomicAdd(rad_in_buf.radiation_in[global_idx], absorption_sum);
                            // Every ray of this launch leaves from face pc.launch_face, so all of it arrived on that face
                            if (pc.face_absorption_enabled != 0u && pc.launch_face == 1u)
                                atomicAdd(rad_in_top_buf.radiation_in_top[global_idx], absorption_sum);
                        }
                    }

                    // What reaches a primitive with a spectral texture, from which each camera computes the outgoing radiation of its classes.
                    // The condition is the same for every invocation, so the subgroupAdd is reached by all of them.
                    if (pc.camera_count > 0u && palette_buf.words[0] != 0u) {
                        float incident_sum = subgroupAdd(field_energy * body_fraction);
                        if (subgroupElect() && incident_sum != 0.0 && spectral_texture_on(prim_idx)) {
                            uint face_slot = (pc.launch_face == 1 ? 0u : pc.source_count + 1u) + pc.source_count;
                            atomicAdd(spectral_incident_buf.values[face_slot * slot_stride + slot_idx], incident_sum);
                        }
                    }

                    // Camera-weighted scatter, once per camera against that camera's rho_cam/tau_cam. This
                    // launch runs once per dispatch rather than once per camera, so weighting by a single
                    // camera here would hand every other camera that camera's image. The loop bound is a
                    // push constant, so control flow stays uniform and the subgroup reductions are reached
                    // by every active invocation.
                    for (uint cam = 0u; cam < pc.camera_count; cam++) {
                        uint cam_mat_idx = mat_idx * pc.camera_count + cam;
                        float rho_cam = use_palette ? spectral_palette_rho_cam(pc.source_count, origin_palette_entry, global_b, cam) : reflectivity_cam_buf.reflectivity_cam[cam_mat_idx];
                        float tau_cam = use_palette ? spectral_palette_tau_cam(pc.source_count, origin_palette_entry, global_b, cam) : transmissivity_cam_buf.transmissivity_cam[cam_mat_idx];
                        if (layer >= 0) {
                            rho_cam *= body_fraction;
                            tau_cam *= body_fraction;
                        }
                        if (origin_is_cover) {
                            // A cover's reflectance is spectrally flat within a band: each camera weights it by its white reference.
                            rho_cam = rho * white_reference_cam_buf.white_reference_cam[(pc.source_count * pc.material_band_count + global_b) * pc.camera_count + cam]; // diffuse/scatter slot
                            tau_cam = 0.0;
                        }
                        float reflect_energy_cam  = field_energy * rho_cam;
                        float transmit_energy_cam = field_energy * tau_cam;
                        float scatter_top_cam_val    = (pc.launch_face == 1) ? reflect_energy_cam : transmit_energy_cam;
                        float scatter_bottom_cam_val = (pc.launch_face == 1) ? transmit_energy_cam : reflect_energy_cam;
                        float scatter_top_cam_sum = subgroupAdd(scatter_top_cam_val);
                        float scatter_bottom_cam_sum = subgroupAdd(scatter_bottom_cam_val);
                        uint cam_slot_idx = cam * slot_stride + slot_idx;
                        if (subgroupElect()) {
                            if (scatter_top_cam_sum != 0.0)
                                atomicAdd(camera_scatter_top_buf.camera_scatter_top[cam_slot_idx], scatter_top_cam_sum);
                            if (scatter_bottom_cam_sum != 0.0)
                                atomicAdd(camera_scatter_bottom_buf.camera_scatter_bottom[cam_slot_idx], scatter_bottom_cam_sum);
                        }
                    }

                    // A normal-mapped primitive records the directions its diffuse radiation came from, with which cameras shade its scattered light per texel. The
                    // header word is the same for every invocation and the slot is the same within a primitive, so the reductions are reached uniformly. The background
                    // field's moments are in a second set of slots.
                    if (normal_map_buf.words[0] != 0u) {
                        uint slot = nm_slot(prim_idx);
                        float body_energy = origin_is_cover ? 0.0 : field_energy * (layer >= 0 ? body_fraction : 1.0);
                        vec3 moment = body_energy * ray_direction;
                        float moment_x = subgroupAdd(moment.x);
                        float moment_y = subgroupAdd(moment.y);
                        float moment_z = subgroupAdd(moment.z);
                        if (subgroupElect() && slot != NO_NORMAL_MAP_SLOT) {
                            uint moment_index = (((slot + field * periodic_info_buf.normal_map_slot_count) * 2u + (pc.launch_face == 1u ? 0u : 1u)) * pc.band_count + band) * 3u;
                            if (moment_index + 3u <= uint(normal_map_moment_buf.values.length())) {
                                atomicAdd(normal_map_moment_buf.values[moment_index], moment_x);
                                atomicAdd(normal_map_moment_buf.values[moment_index + 1u], moment_y);
                                atomicAdd(normal_map_moment_buf.values[moment_index + 2u], moment_z);
                            }
                        }
                    }

                    // What a surface layer reflects of everything arriving goes into the second outgoing component of the launch face,
                    // for every camera weighted by its white reference since the layer reflects all wavelengths alike
                    if (surface_layers_enabled()) {
                        float layer_sum = subgroupAdd(field_energy * layer_albedo);
                        if (subgroupElect() && layer_sum != 0.0) {
                            if (pc.launch_face == 1) {
                                atomicAdd(scatter_top_buf.scatter_top[slot_stride + slot_idx], layer_sum);
                            } else {
                                atomicAdd(scatter_bottom_buf.scatter_bottom[slot_stride + slot_idx], layer_sum);
                            }
                        }
                        for (uint cam = 0u; cam < pc.camera_count; cam++) {
                            float white = white_reference_cam_buf.white_reference_cam[(pc.source_count * pc.material_band_count + global_b) * pc.camera_count + cam];
                            float layer_cam_sum = subgroupAdd(field_energy * layer_albedo * white);
                            uint cam_slot_idx = (pc.camera_count + cam) * slot_stride + slot_idx;
                            if (subgroupElect() && layer_cam_sum != 0.0) {
                                if (pc.launch_face == 1) {
                                    atomicAdd(camera_scatter_top_buf.camera_scatter_top[cam_slot_idx], layer_cam_sum);
                                } else {
                                    atomicAdd(camera_scatter_bottom_buf.camera_scatter_bottom[cam_slot_idx], layer_cam_sum);
                                }
                            }
                        }
                    }
                }

                // White reference: sky light arriving at the launch face, weighted by each camera's response to a white
                // surface. Diffuse rays use the diffuse/scatter slot, as the camera-weighted reflectivity above does. It is that of
                // the scene as it is, with one value per primitive.
                for (uint cam = 0u; cam < pc.camera_count; cam++) {
                    float white = white_reference_cam_buf.white_reference_cam[(pc.source_count * pc.material_band_count + global_b) * pc.camera_count + cam];
                    float white_reference_sum = subgroupAdd(white_reference_energy * white);
                    uint white_global_idx = cam * field_stride + global_idx;
                    if (subgroupElect() && white_reference_sum != 0.0) {
                        if (pc.launch_face == 1) {
                            atomicAdd(white_reference_top_buf.white_reference_top[white_global_idx], white_reference_sum);
                        } else {
                            atomicAdd(white_reference_bottom_buf.white_reference_bottom[white_global_idx], white_reference_sum);
                        }
                    }
                }
            } // band loop
        } // ii loop (sub-patches)
    } // jj loop (sub-patches)
}
