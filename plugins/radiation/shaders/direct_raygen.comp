#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_shader_atomic_float : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

// Direct ray generation shader
// Launches rays from surfaces toward radiation sources

layout(local_size_x = 8, local_size_y = 32, local_size_z = 1) in;

// Push constants (launch parameters)
layout(push_constant) uniform PushConstants {
    uint launch_offset;
    uint launch_count;
    uint rays_per_primitive;
    uint random_seed;
    uint current_band;
    uint band_count;
    uint source_count;
    uint primitive_count;
    uint debug_mode;  // 1 = enable bounds checking with error codes, 0 = production (no checks)
    uint launch_dim_x;    // Grid dimension X for stratified sampling
    uint launch_dim_y;    // Grid dimension Y for stratified sampling
    uint prim_tiles_y;    // Number of primitive tiles in Y dimension (for large primitive counts)
    uint prims_per_tile;  // Primitives per tile (65535 max)
    uint material_band_count;  // Global band count (for material buffers)
    uint periodic_flag_x;      // 1 if periodic in X direction
    uint periodic_flag_y;      // 1 if periodic in Y direction
    uint bbox_count;           // Number of bbox faces (0-4)
    float domain_xmin;         // Domain bounds for periodic wrapping
    float domain_xmax;
    float domain_ymin;
    float domain_ymax;
    uint specular_reflection_enabled;  // 0=disabled, 1=enabled
    uint camera_count;                 // Number of cameras; 0 = skip camera-weighted scatter
    uint camera_id;                    // Camera whose weighting the camera-scatter buffers accumulate
    uint face_absorption_enabled;      // 1 = also accumulate the absorption that arrived on the top face into radiation_in_top
} pc;

// ========== Descriptor Set 0: Geometry ==========
layout(set = 0, binding = 0) readonly buffer BVHBuffer {
    float data[];
} bvh_buf;

layout(set = 0, binding = 2) readonly buffer TransformMatricesBuffer {
    float matrices[]; // 16 floats per primitive (row-major)
} transform_buf;

layout(set = 0, binding = 3) readonly buffer PrimTypesBuffer {
    uint types[];
} prim_types_buf;

layout(set = 0, binding = 4) readonly buffer PrimUUIDsBuffer {
    uint uuids[];
} prim_uuids_buf;

layout(set = 0, binding = 5) readonly buffer PrimPositionsBuffer {
    uint positions[];
} prim_positions_buf;

layout(set = 0, binding = 6) readonly buffer ObjectSubdivisionsBuffer {
    ivec2 subdivisions[];
} obj_subdivisions_buf;

layout(set = 0, binding = 7) readonly buffer TwosidedFlagBuffer {
    uint twosided_flags[];
} twosided_buf;

layout(set = 0, binding = 8) readonly buffer LeafRecordBuffer {
    vec4 records[]; // 4 vec4 per BVH leaf slot (layout in common/intersections.glsl)
} leaf_records_buf;

layout(set = 0, binding = 10) readonly buffer NormalsBuffer {
    float normals[]; // 3 floats per primitive (pre-computed world-space normal)
} normals_buf;

// ---- Texture masking buffers ----
layout(set = 0, binding = 11) readonly buffer MaskDataBuffer { uint mask_data[]; } mask_data_buf;
layout(set = 0, binding = 12) readonly buffer MaskSizesBuffer { ivec2 mask_sizes[]; } mask_sizes_buf;
layout(set = 0, binding = 13) readonly buffer MaskOffsetsBuffer { uint mask_offsets[]; } mask_offsets_buf;
layout(set = 0, binding = 14) readonly buffer MaskIDsBuffer { int mask_ids[]; } mask_ids_buf;
layout(set = 0, binding = 15) readonly buffer UVDataBuffer { vec2 uv_data[]; } uv_data_buf;
layout(set = 0, binding = 16) readonly buffer UVIDsBuffer { int uv_ids[]; } uv_ids_buf;
// Camera flux smoothing topology, 4 entries per primitive; entry 4*prim is negative for a primitive taking no part in smoothing, and the buffer is a single entry when smoothing is off
layout(set = 0, binding = 18) readonly buffer SmoothingVertexIndicesBuffer { int indices[]; } smoothing_indices_buf;

// ---- Periodic boundary bbox vertices ----
layout(set = 0, binding = 17) readonly buffer BboxVerticesBuffer {
    float vertices[]; // 12 floats per face (4 vec3 vertices)
} bbox_verts_buf;
// Periodic copies of the domain rays track (see common/periodic_boundary.glsl and VulkanComputeBackend::uploadPeriodicInfo())
layout(set = 0, binding = 22) readonly buffer PeriodicInfoBuffer {
    uint tile_tracking; // 1 if rays track the periodic copy of the domain they are in
    int max_repeats_x; // periodic copies on each side of the central domain; -1 for no limit
    int max_repeats_y;
    float repeated_zmin; // z-range of the geometry that repeats
    float repeated_zmax;
    float escape_offset; // distance beyond a face from which a ray leaving the periodic copies continues
    int camera_tile_x; // periodic copy of the domain the camera is in (camera and pixel-label launches)
    int camera_tile_y;
    uint flux_field_count; // radiation fields: 2 with a background field (see common/buffer_indexing.glsl), else 1
    uint flux_slot_count; // flux slots of the outgoing, scattered, camera and direct-flux buffers: primitive_count per field
    uint normal_map_slot_count; // normal-map slots; the background field's moments are in slots normal_map_slot_count + slot
    uint vertex_field_stride; // smoothing vertices; the background field's vertex values are at vertex_field_stride + vertex
} periodic_info_buf;
// Whether each primitive is excluded from the periodic boundary (1) or not (0); a one-element placeholder unless there is a background radiation field (see common/buffer_indexing.glsl)
layout(set = 0, binding = 23) readonly buffer PeriodicExcludedBuffer {
    uint excluded[];
} periodic_excluded_buf;

// ========== Descriptor Set 1: Materials/Sources ==========
// NOTE on the three-float source/sky arrays below: std430 gives an array of `vec3` a 16-byte
// stride, while the host uploads tightly-packed 12-byte helios::vec3. Declaring them as `vec3[]`
// therefore reads the wrong 12 bytes for every element after the first, and reads past the end of
// the allocation for the last one. They are declared as flat float arrays and fetched three at a
// time instead, matching normals_buf.
layout(set = 1, binding = 0) readonly buffer SourcePositionsBuffer {
    float positions[]; // 3 floats per source
} source_positions_buf;

layout(set = 1, binding = 1) readonly buffer SourceTypesBuffer {
    uint types[];
} source_types_buf;

layout(set = 1, binding = 2) readonly buffer SourceRotationsBuffer {
    float rotations[]; // 3 floats per source
} source_rotations_buf;

vec3 get_source_position(uint source_index) {
    uint b = source_index * 3u;
    return vec3(source_positions_buf.positions[b], source_positions_buf.positions[b + 1u], source_positions_buf.positions[b + 2u]);
}

vec3 get_source_rotation(uint source_index) {
    uint b = source_index * 3u;
    return vec3(source_rotations_buf.rotations[b], source_rotations_buf.rotations[b + 1u], source_rotations_buf.rotations[b + 2u]);
}

layout(set = 1, binding = 3) readonly buffer SourceWidthsBuffer {
    vec2 widths[];
} source_widths_buf;

layout(set = 1, binding = 4) readonly buffer SourceFluxesBuffer {
    float fluxes[];
} source_fluxes_buf;

layout(set = 1, binding = 5) readonly buffer ReflectivityBuffer {
    float reflectivity[]; // [primitive * band_count + band]
} reflectivity_buf;

layout(set = 1, binding = 6) readonly buffer TransmissivityBuffer {
    float transmissivity[];
} transmissivity_buf;

// Camera-weighted material properties, indexed [source][primitive][band_global][camera]. These are a
// different integral over wavelength than reflectivity/transmissivity above: those weight the surface
// spectrum by the source spectrum over the band, these additionally weight by the camera's spectral
// response. They coincide only when the response is uniform.
layout(set = 1, binding = 14) readonly buffer ReflectivityCamBuffer {
    float reflectivity_cam[];
} reflectivity_cam_buf;

layout(set = 1, binding = 15) readonly buffer TransmissivityCamBuffer {
    float transmissivity_cam[];
} transmissivity_cam_buf;

// Camera-weighted reflectivity of a spectrally flat, perfectly white surface, indexed [source][band_global][camera]. Weighting the
// light arriving at a primitive by it gives what each camera would record from a white surface there: its white reference.
layout(set = 1, binding = 16) readonly buffer WhiteReferenceCamBuffer {
    float white_reference_cam[];
} white_reference_cam_buf;

layout(set = 1, binding = 10) readonly buffer BandMapBuffer {
    uint map[]; // Maps launch band index → global band index
} band_map_buf;

// Translucent cover (glass/plastic) material. Same [prim * material_band_count + global_band] indexing
// as reflectivity/transmissivity (source-0 slice; glass is source-independent).
layout(set = 1, binding = 11) readonly buffer IsGlassBuffer {
    uint is_glass[];
} is_glass_buf;

layout(set = 1, binding = 12) readonly buffer GlassNBuffer {
    float glass_n[];
} glass_n_buf;

layout(set = 1, binding = 13) readonly buffer GlassKLBuffer {
    float glass_KL[];
} glass_KL_buf;

// ========== Descriptor Set 2: Results ==========
layout(set = 2, binding = 0) buffer RadiationInBuffer {
    float radiation_in[]; // [primitive * band_count + band]
} rad_in_buf;

// Absorption that arrived on the top face (the side the normal points to), same layout as radiation_in. Written only when
// pc.face_absorption_enabled is set; otherwise it is a one-element placeholder.
layout(set = 2, binding = 15) buffer RadiationInTopBuffer {
    float radiation_in_top[]; // [primitive * band_count + band]
} rad_in_top_buf;

layout(set = 2, binding = 1) buffer RadiationOutTopBuffer {
    float radiation_out_top[];
} rad_out_top_buf;

layout(set = 2, binding = 2) buffer RadiationOutBottomBuffer {
    float radiation_out_bottom[];
} rad_out_bottom_buf;

layout(set = 2, binding = 3) buffer ScatterTopBuffer {
    float scatter_top[];
} scatter_top_buf;

layout(set = 2, binding = 4) buffer ScatterBottomBuffer {
    float scatter_bottom[];
} scatter_bottom_buf;

// Camera-weighted scatter. Mirrors scatter_top/scatter_bottom but accumulates against rho_cam/tau_cam,
// with one [primitive][band] block per camera (camera-major). RadiationModel uploads each camera's block
// into radiation_out before that camera's trace, so every camera sees radiance weighted by its own
// spectral response rather than by the band or by another camera's response.
layout(set = 2, binding = 8) buffer CameraScatterTopBuffer {
    float camera_scatter_top[];
} camera_scatter_top_buf;

layout(set = 2, binding = 9) buffer CameraScatterBottomBuffer {
    float camera_scatter_bottom[];
} camera_scatter_bottom_buf;

layout(set = 2, binding = 10) buffer RadiationSpecularBuffer {
    float radiation_specular[]; // [source][flux slot][band] accumulated incident radiation
} radiation_specular_buf;

// Each camera's white reference, laid out like the camera-weighted scatter. Zeroed once per runBand(), so it accumulates over all its launches.
layout(set = 2, binding = 13) buffer WhiteReferenceTopBuffer {
    float white_reference_top[];
} white_reference_top_buf;

layout(set = 2, binding = 14) buffer WhiteReferenceBottomBuffer {
    float white_reference_bottom[];
} white_reference_bottom_buf;

// ========== Descriptor Set 4: Ray counters ==========
// counters[0]: rays abandoned at the periodic wrap limit, read back by the host after the launches of a runBand() call
layout(set = 4, binding = 0) buffer RayCountersBuffer {
    uint counters[];
} ray_counters_buf;

// ========== Include common shader utilities ==========
#include "common/random.glsl"
#include "common/transforms.glsl"
#include "common/buffer_indexing.glsl"
#include "common/glass_cover.glsl"
#include "common/bvh_traversal.glsl"
#include "common/periodic_boundary.glsl"
#include "common/texture_mask.glsl"
#include "common/surface_layer.glsl"
#include "common/spectral_texture.glsl"
#include "common/normal_map.glsl"

const float PI = 3.14159265359;

// Safe acos that clamps input to [-1, 1] to avoid NaN
float acos_safe(float x) {
    return acos(clamp(x, -1.0, 1.0));
}

// ========== Helper Functions ==========

// Sample stratified random point on patch (matches CUDA rayGeneration.cu lines 57-67)
vec3 sample_patch_stratified(inout RNGState rng, uint prim_idx, ivec2 subdivision, ivec2 sub_cell, ivec2 ray_cell, uint Nrays_per_dim) {
    int NX = subdivision.x;
    int NY = subdivision.y;

    float dx = 1.0 / float(NX);
    float dy = 1.0 / float(NY);

    float Rx = rng_float(rng);
    float Ry = rng_float(rng);

    // Stratified sampling within subdivision cell
    // Map to patch local space [-0.5, 0.5] x [-0.5, 0.5]
    vec3 sp;
    sp.x = -0.5 + sub_cell.x * dx + float(ray_cell.x) * dx / float(Nrays_per_dim) + Rx * dx / float(Nrays_per_dim);
    sp.y = -0.5 + sub_cell.y * dy + float(ray_cell.y) * dy / float(Nrays_per_dim) + Ry * dy / float(Nrays_per_dim);
    sp.z = 0.0;

    return sp;
}

// Sample random point on triangle
vec3 sample_triangle(inout RNGState rng) {
    float Rx = rng_float(rng);
    float Ry = rng_float(rng);

    vec3 sp;
    // Map to triangle with vertices (0,0,0), (0,1,0), (1,1,0)
    if (Rx < Ry) {
        sp.x = Rx;
        sp.y = Ry;
    } else {
        sp.x = Ry;
        sp.y = Rx;
    }
    sp.z = 0.0;

    return sp;
}

// Sample random point on disk (uniform distribution)
vec3 sample_disk(inout RNGState rng) {
    float Rx = rng_float(rng);
    float Ry = rng_float(rng);

    // Map to square [-1,1] x [-1,1]
    vec3 sp;
    sp.x = -1.0 + 2.0 * Rx;
    sp.y = -1.0 + 2.0 * Ry;

    // Concentric disk mapping (Shirley & Chiu 1997)
    float r, phi;
    if (sp.x > -sp.y) {
        if (sp.x > sp.y) {
            r = sp.x;
            phi = sp.y / sp.x;
        } else {
            r = sp.y;
            phi = 2.0 - sp.x / sp.y;
        }
    } else {
        if (sp.x < sp.y) {
            r = -sp.x;
            phi = 4.0 + sp.y / sp.x;
        } else {
            r = -sp.y;
            if (sp.y != 0.0) {
                phi = 6.0 - sp.x / sp.y;
            } else {
                phi = 0.0;
            }
        }
    }
    phi *= 0.25 * 3.14159265359;

    sp.x = r * cos(phi);
    sp.y = r * sin(phi);
    sp.z = 0.0;

    return sp;
}

// Sample uniform point on square [-0.5, 0.5]²
// Matches CUDA d_sampleSquare() (RayTracing.cuh:490-502)
vec3 sample_square(inout RNGState rng) {
    float Rx = rng_float(rng);
    float Ry = rng_float(rng);
    return vec3(-0.5 + Rx, -0.5 + Ry, 0.0);
}

#include "common/source_sampling.glsl"

// ========== Main Shader ==========
void main() {
    // 3D dispatch with 2D primitive tiling: X = ray grid X, Y = ray grid Y + primitive tiles, Z = primitives
    // For large primitive counts (>65535), primitives are tiled into the Y dimension to avoid sub-batching
    uint launch_x = gl_GlobalInvocationID.x;  // Ray grid X [0, launch_dim_x)

    // Decode Y dimension: lower bits = ray grid Y, upper bits = primitive tile index
    // FIX: Tile by workgroup boundaries (WG_Y), not by logical ray grid size (launch_dim_y).
    // The dispatch allocates dispatch_y_rays * WG_Y threads per tile, where dispatch_y_rays = ceil(launch_dim_y / WG_Y).
    // For launch_dim_y <= WG_Y, this is exactly WG_Y threads per tile.
    const uint WG_Y = 32;  // Must match layout(local_size_y = 32)
    uint threads_per_tile = ((pc.launch_dim_y + WG_Y - 1) / WG_Y) * WG_Y;  // Round up to workgroup multiple
    uint prim_tile_y = gl_GlobalInvocationID.y / threads_per_tile;
    uint launch_y = gl_GlobalInvocationID.y % threads_per_tile;  // Position within tile [0, threads_per_tile)

    // Decode primitive index from 2D tiling
    uint prim_batch_idx = prim_tile_y * pc.prims_per_tile + gl_GlobalInvocationID.z;

    // Bounds check: ray grid
    if (launch_x >= pc.launch_dim_x || launch_y >= pc.launch_dim_y) {
        return;
    }

    // Bounds check: primitive index
    if (prim_batch_idx >= pc.launch_count) {
        return;
    }

    uint prim_idx = pc.launch_offset + prim_batch_idx;

    if (prim_idx >= pc.primitive_count) {
        return; // Safety check
    }

    // With a background radiation field, the rays of a primitive that is not excluded from the periodic boundary are dual rays (see traversal_record_excluded in common/bvh_traversal.glsl), which book
    // what they deliver in both fields. The primitive is the same for every invocation of a workgroup, and so is the field count. Must match originBooksBothFields() in OptiX8DeviceCode.cu.
    uint field_count = (dual_field() && periodic_excluded_buf.excluded[prim_idx] == 0u) ? 2u : 1u;
    traversal_record_excluded = field_count == 2u;
    uint field_stride = pc.primitive_count * pc.band_count; // one field's [primitive][band] block
    uint slot_stride = flux_slot_stride(); // one [flux slot][band] block of the outgoing, scattered and camera buffers

    // Total rays per primitive (matches CUDA: Nrays = launch_dim.x * launch_dim.y)
    uint Nrays = pc.launch_dim_x * pc.launch_dim_y;
    uint Nrays_per_dim = pc.launch_dim_x; // Square grid, so per-dim = launch_dim_x

    // Per-ray RNG seed (matches CUDA: tea(ray_index + Nrays * launch_index.z, random_seed))
    uint ray_index = pc.launch_dim_x * launch_y + launch_x;
    RNGState rng = rng_init(pc.random_seed, ray_index + Nrays * prim_idx);

    // Get primitive data
    uint prim_type = prim_types_buf.types[prim_idx];
    uint prim_uuid = prim_uuids_buf.uuids[prim_idx];
    ivec2 subdivisions = obj_subdivisions_buf.subdivisions[prim_idx];
    uint twosided = twosided_buf.twosided_flags[prim_idx];

    // A translucent cover books what reaches it with its angular glass properties, not rho/tau.
    bool origin_is_cover = glass_cover_all_bands(prim_idx, pc.band_count, pc.material_band_count);

    // Get transform matrix (16 floats per primitive)
    float transform_mat[16];
    for (uint i = 0; i < 16; ++i) {
        transform_mat[i] = transform_buf.matrices[prim_idx * 16 + i];
    }
    mat4 transform = floats_to_mat4(transform_mat);

    // Loop over sub-patches (for patches with subdivisions)
    int NX = subdivisions.x;
    int NY = subdivisions.y;

    // Debug mode bounds checking (only when pc.debug_mode == 1)
    if (pc.debug_mode == 1) {
        // Check for invalid subdivision values
        if (NX <= 0 || NY <= 0) {
            rad_in_buf.radiation_in[0] = -999.0; // Error: invalid subdivisions
            rad_in_buf.radiation_in[1] = float(NX);
            rad_in_buf.radiation_in[2] = float(NY);
            return;
        }

        // Check for unreasonably large subdivisions (likely indicates data corruption)
        if (NX > 10000 || NY > 10000) {
            rad_in_buf.radiation_in[0] = -998.0; // Error: subdivisions too large
            rad_in_buf.radiation_in[1] = float(NX);
            rad_in_buf.radiation_in[2] = float(NY);
            return;
        }

        // Check for invalid ray counts
        if (Nrays_per_dim == 0) {
            rad_in_buf.radiation_in[0] = -997.0; // Error: zero rays
            return;
        }

        // Check for unreasonably large ray counts per dimension
        if (Nrays_per_dim > 100000) {
            rad_in_buf.radiation_in[0] = -996.0; // Error: too many rays per dimension
            rad_in_buf.radiation_in[1] = float(Nrays_per_dim);
            return;
        }
    }

    for (int jj = 0; jj < NY; ++jj) {
        for (int ii = 0; ii < NX; ++ii) {

            // Sample random point on primitive surface using ray grid position
            vec3 sp_local;

            if (prim_type == 0 || prim_type == 3) { // Patch or Tile
                sp_local = sample_patch_stratified(rng, prim_idx, subdivisions, ivec2(ii, jj), ivec2(launch_x, launch_y), Nrays_per_dim);

            } else if (prim_type == 1) { // Triangle
                sp_local = sample_triangle(rng);

            } else {
                continue;
            }

            // Origin masking: reject transparent texels (matches OptiX d_sampleTexture_patch, RayTracing.cuh:504)
            // Note: OptiX ignores the return value and traces the ray anyway if masking fails after 10 retries
            if (prim_type == 0 || prim_type == 3) { // Patch or Tile
                int mask_id_check = mask_ids_buf.mask_ids[prim_idx];
                if (mask_id_check >= 0) {
                    vec2 sample_uv = vec2(sp_local.x + 0.5, sp_local.y + 0.5);
                    int resample_count = 0;
                    while (!check_texture_mask(prim_idx, sample_uv, prim_type) && resample_count < 10) {
                        resample_count++;
                        float dx = 1.0 / float(NX);
                        float dy = 1.0 / float(NY);
                        sp_local.x = -0.5 + (float(ii) + rng_float(rng)) * dx;
                        sp_local.y = -0.5 + (float(jj) + rng_float(rng)) * dy;
                        sp_local.z = 0.0;
                        sample_uv = vec2(sp_local.x + 0.5, sp_local.y + 0.5);
                    }
                    // Don't skip ray - OptiX uses the last sample even if origin masking failed
                }
            } else if (prim_type == 1 && mask_ids_buf.mask_ids[prim_idx] >= 0) {
                // Triangle origin masking via rejection sampling
                int mask_id = mask_ids_buf.mask_ids[prim_idx];
                bool masked = true;
                for (int attempt = 0; attempt < 50 && masked; attempt++) {
                    // Generate random point on canonical triangle
                    float r1 = rng_float(rng);
                    float r2 = rng_float(rng);
                    if (r1 + r2 > 1.0) { r1 = 1.0 - r1; r2 = 1.0 - r2; }
                    sp_local = vec3(r2, r1 + r2, 0.0); // canonical: x=gamma, y=beta+gamma
                    float beta = r1;  // sp_local.y - sp_local.x
                    float gamma = r2; // sp_local.x
                    masked = !mask_texel_is_opaque(mask_id, triangle_texture_uv(prim_idx, vec2(beta, gamma)));
                }
                // If all attempts hit transparent texels, launch from the last sample rather than drop the ray and its energy
            }

            // The class of a spectral texture at the launch point, whose reflectivity and transmissivity the rays from it use
            uint origin_palette_entry = spectral_palette_entry(prim_idx, spectral_origin_texel_uv(prim_idx, prim_type, sp_local));

            // Read pre-computed world-space normal from buffer
            uint nbase = prim_idx * 3;
            vec3 normal = vec3(normals_buf.normals[nbase], normals_buf.normals[nbase + 1], normals_buf.normals[nbase + 2]);

            // The shading normal of a normal map at the launch point, which only a surface layer's angle-dependent split of the light uses here
            uint origin_map = nm_map_index(prim_idx);
            bool origin_has_normal = origin_map != NO_NORMAL_MAP && !origin_is_cover && surface_layer_present(prim_idx);
            vec3 origin_shading_normal = normalize(normal);
            if (origin_has_normal) {
                origin_shading_normal = nm_shading_normal(prim_idx, prim_type, origin_map, normalize(normal), sp_local.x, sp_local.y, false);
            }

            // Transform to world space
            vec3 ray_origin = transform_point(transform, sp_local);

            // Send ray to each source
            for (uint src_idx = 0; src_idx < pc.source_count; ++src_idx) {

                uint source_type = source_types_buf.types[src_idx];
                vec3 ray_dir;
                vec3 source_target; // point sampled on a finite source, where the shadow ray ends
                float source_factor;
                if (!sample_source_direction(src_idx, ray_origin, rng, ray_dir, source_target, source_factor)) {
                    continue; // the back of a rectangle or disk source, or an unknown source type
                }
                float strength = abs(dot(normal, ray_dir)) / float(Nrays) * source_factor;

                // Check if ray is facing the correct direction
                float dot_product = dot(ray_dir, normal);
                bool is_top_face = (dot_product > 0.0);

                // Skip invisible primitives, and the bottom face unless the primitive is two-sided
                if (twosided == 3 || (!is_top_face && twosided != 1)) {
                    continue;
                }

                // Per-band translucent-cover transmittance accumulated as the ray passes through glass
                // covers on its way to the source. Starts at 1 (no attenuation).
                float cover_tau[GLASS_MAX_BANDS];
                for (uint cb = 0; cb < pc.band_count && cb < uint(GLASS_MAX_BANDS); ++cb) {
                    cover_tau[cb] = 1.0;
                }

                // Trace the ray toward the source: a glass cover passes it at its angular transmittance, anything else blocks it, and it wraps through periodic boundaries. The ray counts as
                // blocked unless it reaches the source; one that reaches the periodic wrap limit is counted as abandoned, as in the OptiX backends.
                uint reached = trace_to_source(ray_origin, ray_dir, prim_idx, source_type != 0u, length(source_target - ray_origin), pc.periodic_flag_x, pc.periodic_flag_y, pc.bbox_count, pc.domain_xmin,
                                               pc.domain_xmax, pc.domain_ymin, pc.domain_ymax, pc.band_count, pc.material_band_count, cover_tau);
                if (reached == SOURCE_WRAP_LIMIT) {
                    atomicAdd(ray_counters_buf.counters[0], 1u);
                }
                bool is_occluded = reached != SOURCE_REACHED;
                // An excluded primitive a dual ray passed stands between this primitive and the source in the scene as it is
                bool blocked_in_scene = traversal_excluded_passed;

                if (is_occluded) {
                    continue; // Ray blocked - no direct illumination from this source
                }

                // Direct illumination with occlusion
                // Loop over all launched bands
                for (uint band = 0; band < pc.band_count; ++band) {
                    // Get source flux for this band, attenuated by any translucent covers the ray crossed.
                    uint flux_idx = src_idx * pc.band_count + band;
                    float band_cover_tau = (band < uint(GLASS_MAX_BANDS)) ? cover_tau[band] : 1.0;
                    float flux = source_fluxes_buf.fluxes[flux_idx] * band_cover_tau;

                    // Get material properties for this primitive and band.
                    // Radiative properties are per SOURCE: when a source carries a spectrum, the
                    // surface reflectance is integrated against that source's spectrum, so each source
                    // sees its own rho/tau. Dropping the source term here silently applied source 0's
                    // properties to every source.
                    uint global_b = band_map_buf.map[band];
                    uint mat_idx = (src_idx * pc.primitive_count + prim_idx) * pc.material_band_count + global_b;
                    bool use_palette = spectral_palette_applies(origin_palette_entry, global_b);
                    float rho = use_palette ? spectral_palette_rho(src_idx, origin_palette_entry, global_b) : reflectivity_buf.reflectivity[mat_idx];
                    float tau = use_palette ? spectral_palette_tau(src_idx, origin_palette_entry, global_b) : transmissivity_buf.transmissivity[mat_idx];

                    // Calculate absorbed energy (matches CUDA rayHit.cu line 202)
                    float absorption_factor = 1.0 - rho - tau;

                    // A translucent cover absorbs alpha(theta) and reflects rho(theta) back out of the lit face. The
                    // transmitted tau(theta) continues through undeviated and is delivered to the surfaces behind the
                    // cover by their own rays passing through it, so it is not scattered here.
                    if (origin_is_cover) {
                        vec3 cover_tra = glass_cover_tau_rho_alpha(prim_idx, band, pc.material_band_count, abs(dot(ray_dir, normalize(normal))));
                        rho = cover_tra.y;
                        tau = 0.0;
                        absorption_factor = cover_tra.z;
                    }

                    // A surface layer reflects layer_albedo of what arrives; the body absorbs and scatters the rest
                    float layer_albedo = 0.0;
                    float body_fraction = 1.0;
                    int layer = origin_is_cover ? -1 : surface_layer_table(prim_idx, global_b);
                    if (layer >= 0) {
                        // At the angle of the shading normal at the launch point (|m.L|, consistently with the folding of diffuse rays); the intercepted power stays at the geometric cosine
                        layer_albedo = surface_layer_albedo(layer, abs(dot(ray_dir, origin_has_normal ? origin_shading_normal : normalize(normal))));
                        body_fraction = 1.0 - layer_albedo;
                        absorption_factor *= body_fraction;
                        rho *= body_fraction;
                        tau *= body_fraction;
                    }
                    // A dual ray books what it delivers in the background field too. An excluded primitive it passed blocks it in the scene as it is (field 0) only, which few rays
                    // meet. So that the others cost no more than in a scene without a background field, this launch leaves in the background's flux slots (field 1) only what the
                    // excluded primitives kept from the scene as it is, and the backend adds the scene's slots to them when the launch is done (see
                    // VulkanComputeBackend::completeBackgroundField()). The pass count is the same for every invocation of the subgroup, so its reductions are reached uniformly, and a
                    // scene without a background field makes those of one field. Must match bookDirectOnOrigin() in OptiX8DeviceCode.cu, which books both fields in full.
                    uint rad_idx = index_prim_band(prim_idx, band, pc.band_count);
                    uint field_passes = (field_count == 2u && subgroupAdd(blocked_in_scene ? 1u : 0u) > 0u) ? 2u : 1u;
                    for (uint field = 0u; field < field_passes; field++) {
                        // Field 0: what reaches the primitive in the scene as it is. Field 1: what an excluded primitive kept from it.
                        float field_flux = ((field == 1u) == blocked_in_scene) ? flux : 0.0;
                        uint slot_idx = rad_idx + field * field_stride; // [flux slot][band] index of the primitive in this field

                        // What is absorbed is that of the scene as it is
                        if (field == 0u) {
                            float energy = field_flux * strength * absorption_factor;

                            // Accumulate to radiation_in buffer with subgroup reduction
                            // All threads in this subgroup write to the same rad_idx (same primitive),
                            // so we reduce within the subgroup before issuing a single atomic.
                            float subgroup_sum = subgroupAdd(energy);
                            if (subgroupElect()) {
                                atomicAdd(rad_in_buf.radiation_in[rad_idx], subgroup_sum);
                            }
                            // The face can differ between invocations (e.g. rays toward an extended source), so the top-face share gets
                            // its own reduction. The condition is a push constant, so every invocation reaches the subgroupAdd.
                            if (pc.face_absorption_enabled != 0u) {
                                float top_sum = subgroupAdd(is_top_face ? energy : 0.0);
                                if (subgroupElect() && top_sum != 0.0) {
                                    atomicAdd(rad_in_top_buf.radiation_in_top[rad_idx], top_sum);
                                }
                            }
                        }

                        // Scatter: reflected and transmitted energy from direct illumination. Invocations of the same primitive can reach
                        // different faces (rays toward an extended source), so each adds to the top and bottom sums according to its own face
                        // rather than the subgroup taking the face of the invocation that writes.
                        float scatter_rho = field_flux * strength * rho;
                        float scatter_tau = field_flux * strength * tau;
                        float scatter_top_sum = subgroupAdd(is_top_face ? scatter_rho : scatter_tau);
                        float scatter_bottom_sum = subgroupAdd(is_top_face ? scatter_tau : scatter_rho);
                        if (subgroupElect()) {
                            {
                                atomicAdd(scatter_top_buf.scatter_top[slot_idx], scatter_top_sum);
                                atomicAdd(scatter_bottom_buf.scatter_bottom[slot_idx], scatter_bottom_sum);
                            }
                        }

                        // What reaches a primitive with a spectral texture, from which each camera computes the outgoing radiation of its classes.
                        // The condition is the same for every invocation, so the subgroupAdd is reached by all of them.
                        if (pc.camera_count > 0u && palette_buf.words[0] != 0u) {
                            float incident_top_sum = subgroupAdd(is_top_face ? field_flux * strength * body_fraction : 0.0);
                            float incident_bottom_sum = subgroupAdd(is_top_face ? 0.0 : field_flux * strength * body_fraction);
                            if (subgroupElect() && spectral_texture_on(prim_idx)) {
                                {
                                    if (incident_top_sum != 0.0) {
                                        atomicAdd(spectral_incident_buf.values[src_idx * slot_stride + slot_idx], incident_top_sum);
                                    }
                                    if (incident_bottom_sum != 0.0) {
                                        atomicAdd(spectral_incident_buf.values[(pc.source_count + 1u + src_idx) * slot_stride + slot_idx], incident_bottom_sum);
                                    }
                                }
                            }
                        }

                        // Camera-weighted scatter, accumulated in parallel with the band-weighted scatter
                        // above, once per camera against that camera's rho_cam/tau_cam. This launch runs
                        // once per dispatch rather than once per camera, so weighting by a single camera
                        // here would hand every other camera that camera's image. The loop bound is a push
                        // constant, so control flow stays uniform and subgroupAdd is reached by every
                        // active invocation in the subgroup.
                        for (uint cam = 0u; cam < pc.camera_count; cam++) {
                            uint cam_mat_idx = ((src_idx * pc.primitive_count + prim_idx) * pc.material_band_count + global_b) * pc.camera_count + cam;
                            float rho_cam = use_palette ? spectral_palette_rho_cam(src_idx, origin_palette_entry, global_b, cam) : reflectivity_cam_buf.reflectivity_cam[cam_mat_idx];
                            float tau_cam = use_palette ? spectral_palette_tau_cam(src_idx, origin_palette_entry, global_b, cam) : transmissivity_cam_buf.transmissivity_cam[cam_mat_idx];
                            if (layer >= 0) {
                                rho_cam *= body_fraction;
                                tau_cam *= body_fraction;
                            }
                            if (origin_is_cover) {
                                // A cover's reflectance is spectrally flat within a band: each camera weights it by its white reference.
                                rho_cam = rho * white_reference_cam_buf.white_reference_cam[(src_idx * pc.material_band_count + global_b) * pc.camera_count + cam];
                                tau_cam = 0.0;
                            }
                            float rho_cam_energy = field_flux * strength * rho_cam;
                            float tau_cam_energy = field_flux * strength * tau_cam;
                            float scatter_top_cam_sum = subgroupAdd(is_top_face ? rho_cam_energy : tau_cam_energy);
                            float scatter_bottom_cam_sum = subgroupAdd(is_top_face ? tau_cam_energy : rho_cam_energy);
                            uint cam_rad_idx = cam * slot_stride + slot_idx;
                            if (subgroupElect()) {
                                {
                                    atomicAdd(camera_scatter_top_buf.camera_scatter_top[cam_rad_idx], scatter_top_cam_sum);
                                    atomicAdd(camera_scatter_bottom_buf.camera_scatter_bottom[cam_rad_idx], scatter_bottom_cam_sum);
                                }
                            }
                        }

                        // White reference: the light arriving at this face straight from the source, weighted by each camera's
                        // response to a white surface. A camera's "auto" white balance neutralizes it. It is that of the scene as it
                        // is, with one value per primitive.
                        if (field == 0u) {
                            for (uint cam = 0u; cam < pc.camera_count; cam++) {
                                float white = white_reference_cam_buf.white_reference_cam[(src_idx * pc.material_band_count + global_b) * pc.camera_count + cam];
                                float white_energy = field_flux * strength * white;
                                float white_reference_top_sum = subgroupAdd(is_top_face ? white_energy : 0.0);
                                float white_reference_bottom_sum = subgroupAdd(is_top_face ? 0.0 : white_energy);
                                uint white_rad_idx = cam * field_stride + rad_idx;
                                if (subgroupElect()) {
                                    atomicAdd(white_reference_top_buf.white_reference_top[white_rad_idx], white_reference_top_sum);
                                    atomicAdd(white_reference_bottom_buf.white_reference_bottom[white_rad_idx], white_reference_bottom_sum);
                                }
                            }
                        }

                        // The reflected energy is also kept in the face's second outgoing component, so that the host counts it in the energy
                        // the launch delivering the lobe scatters, or absorbs it in place if that launch never comes; the host clears it
                        // before that launch reads the outgoing buffers (cameras use the lobe alone)
                        if (surface_layers_enabled()) {
                            float layer_energy = field_flux * strength * layer_albedo;
                            float layer_top_sum = subgroupAdd(is_top_face ? layer_energy : 0.0);
                            float layer_bottom_sum = subgroupAdd(is_top_face ? 0.0 : layer_energy);
                            if (subgroupElect()) {
                                {
                                    if (layer_top_sum != 0.0) {
                                        atomicAdd(scatter_top_buf.scatter_top[slot_stride + slot_idx], layer_top_sum);
                                    }
                                    if (layer_bottom_sum != 0.0) {
                                        atomicAdd(scatter_bottom_buf.scatter_bottom[slot_stride + slot_idx], layer_bottom_sum);
                                    }
                                }
                            }
                        }

                        // A surface layer reflects a source's direct radiation into its microfacet lobe around the mirror direction, which
                        // the rays reading the first scattering of the direct radiation evaluate from the incident flux stored here
                        // With camera flux smoothing, every smoothed primitive records it as well, for the camera to evaluate the direct radiation with the shading normal
                        if (pc.specular_reflection_enabled > 0) {
                            bool smoothed = !origin_is_cover && smoothing_indices_buf.indices.length() > int(prim_idx) * 4 + 3 && smoothing_indices_buf.indices[int(prim_idx) * 4] >= 0;
                            // Also recorded for a primitive with a normal map, whose direct radiation cameras shade per hit point with the shading normal
                            float spec_energy = (layer >= 0 || smoothed || (origin_map != NO_NORMAL_MAP && !origin_is_cover)) ? field_flux * strength : 0.0;
                            float spec_sum = subgroupAdd(spec_energy);
                            if (subgroupElect()) {
                                {
                                    atomicAdd(radiation_specular_buf.radiation_specular[direct_flux_index(src_idx, prim_idx, field, band)], spec_sum);
                                }
                            }
                        }
                    }
                }
            }
        } // ii loop
    } // jj loop
}
